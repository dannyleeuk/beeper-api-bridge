# /etc/systemd/system/beeper-api-bridge.service — the Python appservice. Adjust User/paths.
[Unit]
Description=beeper-api-bridge: notification API for Beeper
Documentation=https://github.com/beeper/bridge-manager
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=bridge
Group=bridge
WorkingDirectory=/opt/beeper-api-bridge
Environment=HOME=/opt/beeper-api-bridge
ExecStart=/usr/bin/python3 /opt/beeper-api-bridge/beeper_api_bridge.py --config /opt/beeper-api-bridge/config.json
Restart=always
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
